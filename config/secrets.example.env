# Environment-variable names used by local Oratrice/LiteLLM workflows.
# Keep these values empty in this example.  Supply real values through a
# process environment or secret manager; never commit a populated copy.

# Required by D:\AI\infrastructure\litellm\start.bat.
ORATRICE_LITELLM_MASTER_KEY=

# Optional: only for an explicit DeepSeek live check with --allow-cloud.
DEEPSEEK_API_KEY=
